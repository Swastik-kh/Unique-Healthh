rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: no access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Organizations can access their own content
    match /officeSettings/{orgId} {
      allow read, write: if request.auth != null; // Ideally check user's org
    }
    
    match /citizenServices/{serviceId} {
      allow read: if true; // Publicly readable
      allow write: if request.auth != null; // Only authenticated staff
    }
    
    match /gunasos/{gunasoId} {
      allow create: if true; // Anyone can submit a gunaso
      allow read, update, delete: if request.auth != null; // Only authenticated staff can manage
    }
  }
}
